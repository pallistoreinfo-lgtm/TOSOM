# Use a long, unique password (minimum 12 characters).
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Fine-grained GitHub token with Contents: Read and write access to this repo only.
GITHUB_CONTENT_TOKEN=github_pat_replace_me
GITHUB_OWNER=pallistoreinfo-lgtm
GITHUB_REPO=TOSOM
GITHUB_BRANCH=main

# Drafts and published runtime content live here. The admin creates this branch automatically.
# Vercel deployments for this branch are disabled in vercel.json.
GITHUB_CONTENT_BRANCH=cms-content
